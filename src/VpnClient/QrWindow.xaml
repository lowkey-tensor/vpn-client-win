<Window x:Class="VpnClient.QrWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="QR-код конфига" SizeToContent="WidthAndHeight" ResizeMode="NoResize"
        Background="{StaticResource Bg}" Foreground="{StaticResource Text}" FontSize="14"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <StackPanel Margin="22" Width="320">
        <TextBlock x:Name="NameText" FontSize="16" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" HorizontalAlignment="Center"/>
        <TextBlock Text="Отсканируйте в Happ, Hiddify или v2rayNG" Foreground="{StaticResource Muted}" FontSize="12"
                   HorizontalAlignment="Center" Margin="0,4,0,14"/>
        <Border Background="White" CornerRadius="14" Padding="14" HorizontalAlignment="Center">
            <Image x:Name="QrImage" Width="260" Height="260" RenderOptions.BitmapScalingMode="NearestNeighbor"/>
        </Border>
        <Border Background="#2AFF5A5A" CornerRadius="10" Padding="10,8" Margin="0,14,0,14">
            <TextBlock TextWrapping="Wrap" FontSize="12" Foreground="#FFB4B4"
                       Text="В коде ключ доступа к вашему серверу. Не показывайте и не отправляйте его посторонним."/>
        </Border>
        <UniformGrid Columns="2">
            <Button Style="{StaticResource Btn}" Content="Копировать ссылку" Margin="0,0,6,0" Click="OnCopy"/>
            <Button Style="{StaticResource AccentBtn}" Content="Закрыть" Margin="6,0,0,0" IsCancel="True" Click="OnClose"/>
        </UniformGrid>
    </StackPanel>
</Window>
